---
/** Каркас страниц магазина «Вариант 1»: SEO-теги, шапка, полноэкранное меню, подвал, шторки корзины
    и избранного (остров Sheets). Стиль – новая главная «Подиум» (home.css, home-blocks.css) + v1.css. */
import '@fontsource/playfair-display/cyrillic-400.css';
import '@fontsource/playfair-display/latin-400.css';
import '@fontsource/playfair-display/cyrillic-400-italic.css';
import '@fontsource/playfair-display/latin-400-italic.css';
import pfLatin from '@fontsource/playfair-display/files/playfair-display-latin-400-normal.woff2?url';
import '../styles/home.css';
import '../styles/home-blocks.css';
import '../styles/v1.css';
import Sheets from '../v1/islands/Sheets';
import { API_MODE } from '../v1/loyalty';
import CookieBanner from '../v1/islands/CookieBanner';
import Preloader from '../v1/Preloader.astro';
import { v1, asset, img, MENU, MENU_PHOTO, MENU_INFO, FOOTER, SOCIAL, PHONE, EMAIL, ADDRESS } from '../v1/site';

interface Props {
  title: string;
  description: string;
  /** путь страницы магазина без /v1/ ('' – главная) */
  path: string;
  image?: string;
  /** JSON-LD объекты страницы */
  ld?: object[];
  /** главная с видео-экраном: прозрачная шапка и предзагрузка шрифта слова ALEX KROWN */
  hero?: boolean;
  ogType?: string;
  /** главное фото страницы (LCP) – предзагрузка с высоким приоритетом */
  lcp?: { href: string; srcset: string; sizes: string };
}
const { title, description, path, image, ld = [], hero = false, ogType = 'website', lcp } = Astro.props;
const canonical = new URL(v1(path), Astro.site).href;
/* показ на GitHub Pages закрыт от поиска (дубль живого сайта); на боевом домене PUBLIC_INDEX=1.
   Личный кабинет /v1/account/* закрыт всегда: данные покупателя, а не страница для поиска (docs/ПЛАН-ЛК.md, решение 5) */
const noindex = process.env.PUBLIC_INDEX !== '1' || /^(account(\/|$)|checkout$|checkout-paid$|favorites$|404$)/.test(path); // оформление, итог оплаты, избранное и 404 – служебные, не для поиска
/* счётчик Метрики – только на боевом домене (PUBLIC_METRIKA_ID, у alex-krown.com 112281637): на показе в GitHub
   события электронной коммерции (v1/ecommerce.ts) копятся в dataLayer и никуда не уходят, статистика сайта чистая */
const metrika = Number(process.env.PUBLIC_METRIKA_ID) || 0;
/* Метрика – только после «Принимаю» в окне cookie (152-ФЗ ст. 9, остров CookieBanner, как у EV SIBIR):
   akInitMetrika вызывает окно или повторный визит с сохранённым согласием; «Отказаться» – счётчик не грузится */
const metrikaTag = metrika
  ? `window.dataLayer=window.dataLayer||[];window.akInitMetrika=function(){if(window.akMetrikaLoaded)return;window.akMetrikaLoaded=true;(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");ym(${metrika},"init",{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true,ecommerce:"dataLayer"});};try{if(localStorage.getItem("ak-cookie-consent")==="accepted")window.akInitMetrika()}catch(e){}`
  : '';
/* без своей картинки (служебные и текстовые страницы) – кадр бренда с главной, чтобы ссылка в мессенджере была с превью */
const ogImage = new URL(image ?? asset('concepts/video/milan-mfw2025-street.webp'), Astro.site).href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ALEX KROWN',
  url: new URL(v1(''), Astro.site).href,
  logo: new URL(asset('concepts/img/logo.svg'), Astro.site).href,
  sameAs: SOCIAL.map(([, h]) => h),
  telephone: PHONE.replace(/[^\d+]/g, ''),
  address: { '@type': 'PostalAddress', addressLocality: 'Новосибирск', streetAddress: ADDRESS.replace(/^Новосибирск,\s*/, ''), addressCountry: 'RU' },
};
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ALEX KROWN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:locale" content="ru_RU" />
    <meta name="theme-color" content="#0d0d0d" />
    {/* тема – до отрисовки, чтобы страница не мигала; по умолчанию тёмная (бренд) */}
    <script is:inline>
      try {
        if (localStorage.getItem('ak_theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
          document.querySelector('meta[name=theme-color]').content = '#f4f4f2';
        }
      } catch {}
    </script>
    <link rel="icon" href={asset('concepts/img/logo.svg')} type="image/svg+xml" />
    {hero && <link rel="preload" href={pfLatin} as="font" type="font/woff2" crossorigin />}
    {lcp && <link rel="preload" as="image" href={lcp.href} imagesrcset={lcp.srcset} imagesizes={lcp.sizes} fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify(path === '' ? [org, ...ld] : ld)} />
    {metrikaTag && <script is:inline set:html={metrikaTag} />}
  </head>
  <body style={`--logo:url(${asset('concepts/img/logo.svg')})`}>
    {/* заставка-глитч – только на главной: варианты по ?intro=1…5 (см. v1/Preloader.astro) */}
    {hero && <Preloader />}
    <header class:list={['hd', { 'is-solid': !hero }]} data-hd data-hero-page={hero ? '' : undefined}>
      <nav>
        <a href={v1('catalog')} class="hd__hide">Каталог</a>
        <a href={v1('catalog/man')}>Мужское</a>
        <a href={v1('catalog/woman')}>Женское</a>
        <a href={v1('about')} class="hd__hide">О нас</a>
      </nav>
      <a href={v1('')} aria-label="ALEX KROWN – на главную"><span class="logo"></span></a>
      <nav class="hd__right">
        {/* на телефоне – значки с цифрами вместо слов (владелец 17.11.2026: «значками с цифрами, минималистично») */}
        <button type="button" data-open-sheet="fav" class="hd__ib" aria-label="Избранное"><svg class="hd__ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" /></svg><span class="hd__txt">Избранное</span><span data-fav-count>0</span></button>
        <button type="button" data-open-sheet="cart" class="hd__ib" aria-label="Корзина"><svg class="hd__ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></svg><span class="hd__txt">Корзина</span><span data-cart-count>0</span></button>
        {/* кабинет: гость – «Войти», вошедший – баланс с короной и пометка «демо» – только в демо-кабинете, не в режиме api (обновляет v1/client.ts по снимку кабинета) */}
        <a href={v1('account')} class="hd__lk" data-lk aria-label="Войти в личный кабинет">
          <svg class="hd__crown" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2.5 7.5 7.5 12 12 4l4.5 8 5-4.5L19.5 18h-15z" /><rect x="4.5" y="19.3" width="15" height="1.9" rx=".4" /></svg>
          <b data-lk-num></b><span class="hd__lk-word" data-lk-word>Войти</span>{!API_MODE && <small class="hd__demo">демо</small>}
        </a>
        <button type="button" class="hd__ib" data-menu-open aria-expanded="false" aria-controls="menu" aria-label="Меню"><svg class="hd__ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg><span class="hd__txt">Меню</span></button>
      </nav>
    </header>

    {/* меню: крупный список разделов, справа фото раздела при наведении (CSS :has, home.css), быстрые ссылки и информация */}
    <div class="menu" id="menu" data-menu aria-hidden="true">
      <button type="button" class="menu__close" data-menu-close>Закрыть</button>
      <nav class="menu__main" aria-label="Разделы магазина">{MENU.map(([t, p]) => <a href={v1(p)} class={`mi mi--${p.replace('/', '-')}`}>{t}</a>)}</nav>
      <div class="menu__side">
        <div class="menu__photo" aria-hidden="true">
          <img class="hp hp--none" src={img('883110873202-1-s')} srcset={`${img('883110873202-1-s')} 480w, ${img('883110873202-1')} 960w`} sizes="40vw" alt="" loading="lazy" />
          {MENU.map(([, p]) => <img class={`hp hp--${p.replace('/', '-')}`} src={img(MENU_PHOTO[p] + '-s')} srcset={`${img(MENU_PHOTO[p] + '-s')} 480w, ${img(MENU_PHOTO[p])} 960w`} sizes="40vw" alt="" loading="lazy" />)}
        </div>
        <div class="menu__quick"><a href={v1('favorites')}><svg class="mq__ico" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" /></svg>Избранное <span data-fav-count>0</span></a><button type="button" data-open-sheet="cart"><svg class="mq__ico" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></svg>Корзина <span data-cart-count>0</span></button><a href={v1('account')}><svg class="mq__ico" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2.5 7.5 7.5 12 12 4l4.5 8 5-4.5L19.5 18h-15z" /><rect x="4.5" y="19.3" width="15" height="1.9" rx=".4" /></svg>Личный кабинет</a></div>
        <div>
          <p class="label">Информация</p>
          <ul style="margin-top:14px">{MENU_INFO.map(([t, p]) => <li><a href={v1(p)}>{t}</a></li>)}</ul>
        </div>
        <div class="ft__social">{SOCIAL.map(([t, h]) => <a href={h} target="_blank" rel="noopener">{t}</a>)}</div>
      </div>
    </div>

    <slot />

    <footer class="ft">
      <div class="ft__top">
        <div>
          <a href={v1('')} aria-label="ALEX KROWN – на главную"><span class="logo" style="width:44px"></span></a>
          <div class="ft__social">{SOCIAL.map(([t, h]) => <a href={h} target="_blank" rel="noopener">{t}</a>)}</div>
          <p class="ft__contacts"><a href={`tel:+${PHONE.replace(/\D/g, '')}`}>{PHONE}</a><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
          <a class="ft__by" href="https://deford-studio.ru/" target="_blank" rel="noopener">Design by Deford</a>
        </div>
        {
          FOOTER.map(([h, links]) => (
            <div>
              <h2 class="ft__h">{h}</h2>
              <ul>{links.map(([t, l]) => <li><a href={v1(l)}>{t}</a></li>)}</ul>
            </div>
          ))
        }
      </div>
      <p class="ft__word" aria-hidden="true">ALEX KROWN</p>
    </footer>

    {/* плавающий виджет слева внизу (владелец 18.11.2026): «Наверх» – появляется, когда листают вверх; под ним – тема */}
    <div class="fl">
      <button type="button" class="fl__btn fl__up" data-to-top aria-label="Наверх" tabindex="-1">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
      </button>
      <button type="button" class="fl__btn hd__theme" data-theme-toggle aria-label="Включить светлую тему" aria-pressed="false">
        <svg class="is-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3 7 7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7" /></svg>
        <svg class="is-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7Z" /></svg>
      </button>
    </div>
    <script is:inline>
      (function () {
        var up = document.querySelector('[data-to-top]');
        if (!up) return;
        var last = scrollY;
        addEventListener('scroll', function () {
          var y = scrollY, d = y - last, on = up.classList.contains('is-on');
          if (y <= 600 || d > 2) on = false; else if (d < -2) on = true;
          up.classList.toggle('is-on', on);
          up.tabIndex = on ? 0 : -1;
          last = y;
        }, { passive: true });
        up.addEventListener('click', function () {
          scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        });
      })();
    </script>

    <Sheets client:idle catalogHref={v1('catalog')} orderHref={v1('checkout')} favHref={v1('favorites')} />
    {metrika > 0 && <CookieBanner client:idle policyHref={v1('privatepolicy')} />}
    <script>
      import '../v1/client';
    </script>
    <script>import '../v1/attribution';</script>
  </body>
</html>

<style>
  .hd__lk {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hd__crown,
  .hd__demo {
    display: none;
  }
  .hd__lk b {
    font-weight: 600;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .hd__demo {
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--mute);
  }
  .hd__lk.is-in .hd__crown,
  .hd__lk.is-in .hd__demo {
    display: inline;
  }
  @media (max-width: 560px) {
    .hd__lk.is-in .hd__lk-word,
    .hd__lk.is-in .hd__demo {
      display: none;
    }
  }
</style>
