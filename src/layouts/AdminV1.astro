---
/** Каркас админки магазина «Вариант 1»: вкладки и шапка как в кабинете Elite Rose (эталон), адрес сайта справа. Закрыта от поиска.
    Острова (Preact) – src/v1/admin/; сохранение каталога – коммитом через GitHub API (src/v1/admin/gh.ts). */
import '../styles/admin.css';
import { v1, asset, allProducts } from '../v1/site';
type Tab = 'pages' | 'products' | 'leads' | 'sales' | 'bonus' | 'metrika' | 'seo' | 'positions' | 'tochka' | 'recommendations';
interface Props { title: string; active: Tab }
const { title, active } = Astro.props;
const site = new URL(v1(''), Astro.site).href;
const tabs: [Tab, string, string, string][] = [
  ['pages', 'admin', 'Страницы сайта', ''],
  ['products', 'admin/products', 'Товары', String(allProducts.length)],
  ['leads', 'admin/leads', 'Заявки', ''],
  ['sales', 'admin/sales', 'Продажи', ''],
  ['bonus', 'admin/bonus', 'Бонусы', ''],
  ['metrika', 'admin/metrika', 'Метрика', ''],
  ['seo', 'admin/seo', 'SEO-аналитика', ''],
  ['positions', 'admin/positions', 'Позиции', ''], // закрыт замком (v1/admin/Locked.astro), пока владелец не откроет
  ['tochka', 'admin/tochka-a', 'Точка А', ''],
  ['recommendations', 'admin/recommendations', 'Рекомендации', ''], // закрыт замком
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} – админка ALEX KROWN</title>
    <link rel="icon" href={asset('concepts/img/logo.svg')} type="image/svg+xml" />
  </head>
  <body class="adm">
    <nav class="topnav" aria-label="Разделы админки">
      <span class="brand"><img src={asset('concepts/img/logo.svg')} alt="" style="border-radius:0;width:auto;height:28px" />ALEX KROWN</span>
      {tabs.map(([key, href, label, n]) => (
        <a class:list={['tab', { on: active === key }]} href={v1(href)}>{label}{n && <span class="n">{n}</span>}</a>
      ))}
      <span class="site">Сайт: <a href={site} target="_blank" rel="noopener">{site.replace(/^https?:\/\//, '')}</a></span>
      {/* выход из кабинета (вход – scripts/lock-admin.mjs, помнится до закрытия вкладки, с галочкой – и после), как «Выйти» у EV; стирает оба входа */}
      <button type="button" class="logout" onclick="try{sessionStorage.removeItem('ak_admin_auth');localStorage.removeItem('ak_admin_keep')}catch(e){};location.reload()" style="background:none;border:0;color:rgba(255,255,255,.75);font:inherit;font-size:13px;cursor:pointer;padding:0">Выйти</button>
    </nav>
    <main><slot /></main>
  </body>
</html>
