---
/** Сейф раздела админки с коммерческими данными (Метрика, SEO, Точка А).
    Репозиторий и показ публичные, своего сервера нет, поэтому:
    – сборка с выгрузкой аналитики (open) рисует раздел целиком – её разметку scripts/seal-admin.mjs
      шифрует паролем владельца в public/v1/admin/vault/<name>.json;
    – публичная сборка рисует только форму пароля: браузер скачивает шифровку и расшифровывает у себя
      (PBKDF2-SHA256 + AES-256-GCM). Пароль на время вкладки – в sessionStorage. */
import { asset } from '../site';
interface Props { name: string; open: boolean }
const { name, open } = Astro.props;
---

{
  open ? (
    <div id="vault" data-vault={name}><slot /></div><div id="vault-end" hidden></div>
  ) : (
    <>
      <form class="panel vault-gate" id="vault-gate" data-src={asset(`v1/admin/vault/${name}.json`)}>
        <h2>Раздел закрыт паролем</h2>
        <p class="muted">Здесь коммерческие данные бренда: посещаемость, заказы, выручка. Они лежат на сайте зашифрованными и открываются только паролем владельца.</p>
        <div class="vault-row">
          <input type="password" name="pass" autocomplete="current-password" placeholder="Пароль админки" required />
          <button class="btn primary" type="submit">Открыть</button>
        </div>
        <p class="vault-msg muted" role="status"></p>
      </form>
      <div id="vault" data-vault={name} data-locked></div>
    </>
  )
}

<style is:global>
  .vault-gate{max-width:560px;margin:40px auto}
  .vault-row{display:flex;gap:10px;margin-top:14px}
  .vault-row input{flex:1;min-width:0;font:inherit;padding:10px 12px;border:1px solid #d6dad8;border-radius:8px}
  .vault-msg{min-height:1.4em;margin:10px 0 0}
</style>

<script>
  const KEY = 'ak_admin_pass';
  const b64 = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));

  async function unlock(form: HTMLFormElement, pass: string) {
    const msg = form.querySelector<HTMLElement>('.vault-msg')!;
    msg.textContent = 'Открываю…';
    try {
      const res = await fetch(form.dataset.src!, { cache: 'no-store' });
      if (!res.ok) throw new Error(res.status === 404 ? 'данные ещё не выложены' : 'ответ ' + res.status);
      const box = await res.json();
      const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(pass), 'PBKDF2', false, ['deriveKey']);
      const key = await crypto.subtle.deriveKey({ name: 'PBKDF2', hash: 'SHA-256', salt: b64(box.salt), iterations: box.iter },
        base, { name: 'AES-GCM', length: 256 }, false, ['decrypt']);
      let plain: ArrayBuffer;
      try {
        plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64(box.iv) }, key, b64(box.data));
      } catch {
        sessionStorage.removeItem(KEY);
        msg.textContent = 'Пароль не подошёл';
        return;
      }
      sessionStorage.setItem(KEY, pass);
      const vault = document.getElementById('vault')!;
      vault.innerHTML = new TextDecoder().decode(plain);
      delete vault.dataset.locked;
      form.remove();
      document.dispatchEvent(new CustomEvent('vault:open'));
    } catch (e) {
      msg.textContent = 'Не открылось: ' + (e instanceof Error ? e.message : String(e));
    }
  }

  const form = document.getElementById('vault-gate') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      unlock(form, String(new FormData(form).get('pass') || ''));
    });
    let saved: string | null = null;
    try { saved = sessionStorage.getItem(KEY); } catch {}
    if (saved) unlock(form, saved);
  } else {
    document.dispatchEvent(new CustomEvent('vault:open'));
  }
</script>
