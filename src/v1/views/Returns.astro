---
/** Обмен и возврат – как на alex-krown.com/return (владелец 17.11.2026: «структурируй, как было»): четыре карточки,
    в заголовке главное выделено. Текст – дословно оригинала (юридический), исправлена только опечатка «Покупателем.,». */
const CARDS: { pre: string; strong: string; post?: string; text: string }[] = [
  {
    pre: 'Покупатель вправе отказаться от товара и вернуть его в течение ', strong: '7 календарных дней.',
    text: 'Возврат товара надлежащего качества возможен в случае, если сохранены его товарный вид, потребительские свойства, а также документ, подтверждающий факт и условия покупки указанного товара (товарная накладная, кассовый чек). В течение этого периода Покупатель обязан известить менеджера магазина письменно на почту alexkrowncom@yandex.ru о желании вернуть товар.',
  },
  {
    pre: 'Покупатель не вправе отказаться от товара ', strong: 'надлежащего качества',
    text: 'имеющего индивидуально-определенные свойства, если указанный товар может быть использован исключительно приобретающим его Покупателем, если товар изготавливался именно под конкретного человека, с его мерками и его пожеланиями, в том числе и в дизайне.',
  },
  {
    pre: 'При отказе Покупателя от товара Интернет-магазин может предложить ему ', strong: 'бессрочный депозит в размере стоимости покупки',
    text: 'на другие приобретения на сайте сразу после получения неподошедшего товара или вернуть полную денежную сумму, уплаченную за товар, за вычетом суммы расходов Интернет-магазина, связанных с доставкой товара Покупателю и вывозом товара от Покупателя.',
  },
  {
    pre: 'Товар ненадлежащего качества может быть заменен ', strong: 'на аналогичный товар', post: ' надлежащего качества',
    text: 'либо возвращен Продавцу, в данном случае доставку товара оплачивает Продавец.',
  },
];
---

<div class="rt">
  {
    CARDS.map((c) => (
      <div class="rt__card">
        <h2>{c.pre}<strong>{c.strong}</strong>{c.post}</h2>
        <p>{c.text}</p>
      </div>
    ))
  }
</div>
