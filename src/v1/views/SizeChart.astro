---
/** Размерная сетка таблицами, данные – alex-krown.com/size_chart (владелец 17.11.2026: «сверстать, а не картинками»,
    затем «некрасиво» → выбран вариант «вкладки»): Мужское / Женское / Унисекс / Обувь, видна одна таблица и рядом фото
    с отметками ОГ/ОТ/ОБ. Вкладки – радиокнопки и CSS, без скрипта.
    Фото – с той же страницы Тильды, в public/v1/img/size-chart-*.webp. Блоки – div, не section: у section в home.css
    верхний отступ до 140px. */
import { img } from '../site';

interface Table { title: string; sizes: string[]; ru?: string[]; rows: [string, string[]][]; photo: string; w: number; h: number }
const TABLES: Table[] = [
  {
    title: 'Мужское', sizes: ['S', 'M', 'L', 'XL', 'XXL'], ru: ['44-46', '48-50', '52-54', '56-58', '60-62'],
    rows: [
      ['Обхват груди (см)', ['88-92', '96-100', '104-108', '112-116', '120-124']],
      ['Обхват талии (см)', ['80-84', '88-92', '96-100', '104-108', '112-116']],
      ['Обхват бёдер (см)', ['90-94', '98-102', '106-110', '114-118', '122-126']],
    ],
    photo: 'size-chart-men', w: 643, h: 772,
  },
  {
    title: 'Женское', sizes: ['XS', 'S', 'M', 'L', 'XL'], ru: ['40', '42', '44', '46', '48'],
    rows: [
      ['Обхват груди (см)', ['80-84', '82-86', '86-90', '90-94', '94-98']],
      ['Обхват талии (см)', ['60-64', '62-66', '66-70', '70-74', '74-80']],
      ['Обхват бёдер (см)', ['86-90', '90-94', '94-98', '98-102', '102-106']],
    ],
    photo: 'size-chart-women', w: 650, h: 860,
  },
  {
    title: 'Унисекс', sizes: ['S', 'M'],
    rows: [
      ['Обхват груди (см)', ['88-96', '98-104']],
      ['Обхват талии (см)', ['68-78', '80-90']],
    ],
    photo: 'size-chart-unisex', w: 760, h: 611,
  },
];
const SHOES: [string, string][] = [
  ['36', '24'], ['37', '24.5'], ['38', '25'], ['39', '26'], ['40', '26.5'],
  ['41', '27.5'], ['42', '28'], ['43', '29'], ['44', '29.5'], ['45', '30.5'],
];
---

<div class="sc">
  {[...TABLES.map((t) => t.title), 'Обувь'].map((_, i) => <input class="sc__radio" type="radio" name="sc-tab" id={`sc-t${i}`} checked={i === 0} />)}
  <div class="sc__tabs" role="group" aria-label="Размерная сетка">
    {[...TABLES.map((t) => t.title), 'Обувь'].map((t, i) => <label for={`sc-t${i}`} class={`sc__tab sc__tab--${i}`}>{t}</label>)}
  </div>
  {
    TABLES.map((t, i) => (
      <div class={`sc__panel sc__panel--${i}`}>
        <div class="sc__main">
          <div class="sc__scroll">
            <table class="sc__table">
              <thead>
                <tr>
                  <th scope="col">Размер</th>
                  {t.sizes.map((s, k) => (
                    <th scope="col">
                      <span class="sc__size">{s}</span>
                      {t.ru && <span class="sc__ru">{t.ru[k]}</span>}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {t.rows.map(([name, vals]) => (
                  <tr>
                    <th scope="row">{name}</th>
                    {vals.map((v) => <td>{v}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="sc__legend"><b>ОГ</b> – обхват груди · <b>ОТ</b> – обхват талии{t.rows.length > 2 && <> · <b>ОБ</b> – обхват бёдер</>}</p>
        </div>
        <figure class="sc__fig">
          <img src={img(t.photo)} width={t.w} height={t.h} alt={`Где измерять: ${t.title.toLowerCase()} – ОГ, ОТ, ОБ`} loading="lazy" />
        </figure>
      </div>
    ))
  }
  <div class={`sc__panel sc__panel--${TABLES.length} sc__panel--shoes`}>
    <div class="sc__main">
      <div class="sc__scroll">
        <table class="sc__table sc__table--shoes">
          <thead><tr><th scope="col">Размер RU</th>{SHOES.map(([ru]) => <th scope="col"><span class="sc__size">{ru}</span></th>)}</tr></thead>
          <tbody><tr><th scope="row">Длина стельки</th>{SHOES.map(([, cm]) => <td>{cm} см</td>)}</tr></tbody>
        </table>
      </div>
      <div class="sc__how">
        <h2>Как подобрать размер?</h2>
        <ol>
          <li>Размер подбирается не по стопе, а по стельке из обуви.</li>
          <li>Достаньте стельку из обуви.</li>
          <li>Измерьте длину стельки от пятки до самого длинного края.</li>
          <li>Сопоставьте получившееся значение со значением в таблице.</li>
        </ol>
      </div>
    </div>
    <figure class="sc__fig sc__fig--insole">
      <img src={img('size-chart-insole')} width="337" height="699" alt="Длина стельки – от пятки до самого длинного края" loading="lazy" />
    </figure>
  </div>
</div>
