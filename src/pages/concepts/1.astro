---
/** Концепт 1 «Подиум»: три вертикальных видео бренда в ряд (в центре – Milan
    Fashion Week 2025), поверх – слово ALEX KROWN в режиме «разница».
    Видео чёрно-белые; колонка под курсором раскрывается и становится цветной.
    На телефоне – одно видео из Милана на весь экран. */
import ConceptLayout from '../../components/ConceptLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const v = (n: string) => `${base}/concepts/video/${n}`;
const cols = [
  ['campaign-white-suit', 'Девушка в белом худи с капюшоном и чёрными кантами'],
  ['milan-mfw2025-street', 'Модель ALEX KROWN у площадки Milan Fashion Week 2025'],
  ['campaign-black-street', 'Мужчина в чёрном худи и джоггерах идёт по улице'],
];
---

<ConceptLayout n={1} title="Подиум" theme="dark">
  <main class="stage">
    <header class="hd">
      <nav>
        <a href={`${base}/catalog/man`}>Мужское</a>
        <a href={`${base}/catalog/woman`}>Женское</a>
      </nav>
      <a href={`${base}/`} class="hd__logo" aria-label="ALEX KROWN"><span class="ak-logo"></span></a>
      <nav class="hd__right">
        <a href={`${base}/about`} class="hd__hide">О бренде</a>
        <a href="#">Корзина 0</a>
      </nav>
    </header>

    <div class="reel">
      {
        cols.map(([n, alt], i) => (
          <figure class={`col${i === 1 ? ' col--main' : ''}`} style={`--i:${i}`}>
            <video
              src={v(`${n}.mp4`)}
              poster={v(`${n}.webp`)}
              autoplay
              muted
              loop
              playsinline
              preload={i === 1 ? 'auto' : 'metadata'}
              aria-label={alt}
            />
            {i === 1 && <figcaption>Milan Fashion Week 2025</figcaption>}
          </figure>
        ))
      }
    </div>

    <h1 class="word">ALEX KROWN</h1>

    <div class="copy">
      <p>Одежда для тех, кто создаёт свои правила</p>
      <div class="copy__cta">
        <a class="btn btn--solid" href={`${base}/catalog/man`}>Мужское</a>
        <a class="btn" href={`${base}/catalog/woman`}>Женское</a>
      </div>
    </div>
  </main>
</ConceptLayout>

<script>
  /* видео играют только на экране: экономия батареи и трафика на телефоне */
  const vids = document.querySelectorAll<HTMLVideoElement>('.reel video');
  const io = new IntersectionObserver((es) =>
    es.forEach((e) => {
      const el = e.target as HTMLVideoElement;
      if (e.isIntersecting && el.offsetParent) el.play().catch(() => {});
      else el.pause();
    }),
  );
  vids.forEach((el) => io.observe(el));
</script>

<style>
  .stage {
    position: relative;
    height: 100dvh;
    min-height: 600px;
    overflow: hidden;
    isolation: isolate;
  }
  .hd {
    position: absolute;
    inset: 0 0 auto;
    z-index: 4;
    height: 72px;
    padding: 0 clamp(16px, 3vw, 40px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper);
  }
  .hd nav {
    display: flex;
    gap: clamp(16px, 2.4vw, 32px);
  }
  .hd__right {
    justify-content: flex-end;
  }
  .hd__logo .ak-logo {
    width: 32px;
  }

  .reel {
    position: absolute;
    inset: 0;
    display: flex;
    gap: 6px;
  }
  .col {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    transition: flex-grow 0.9s var(--ease);
    animation: col-in 1.3s calc(0.15s + var(--i) * 0.12s) var(--ease) both;
  }
  .col--main {
    flex-grow: 1.25;
  }
  .col:hover {
    flex-grow: 1.6;
  }
  .col video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08) brightness(0.78);
    transition: filter 0.9s var(--ease);
  }
  .col:hover video {
    filter: grayscale(0) brightness(0.9);
  }
  .col figcaption {
    position: absolute;
    left: 50%;
    top: 96px;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--paper);
    opacity: 0.85;
  }
  @keyframes col-in {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .word {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-58%);
    z-index: 2;
    text-align: center;
    font: 400 clamp(64px, 14.5vw, 260px) / 1 var(--serif);
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--paper);
    mix-blend-mode: difference;
    pointer-events: none;
    animation: word-in 1.6s 0.6s var(--ease) both;
  }
  @keyframes word-in {
    from {
      opacity: 0;
      letter-spacing: 0.2em;
    }
  }

  .copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    padding: 120px clamp(16px, 3vw, 40px) clamp(80px, 10vh, 96px);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    background: linear-gradient(to top, rgba(13, 13, 13, 0.85), transparent);
    pointer-events: none;
    animation: fade 1s 1.1s var(--ease) both;
  }
  .copy p {
    font: italic 400 clamp(20px, 2vw, 30px) / 1.2 var(--serif);
    max-width: 18ch;
  }
  .copy__cta {
    display: flex;
    gap: 8px;
    pointer-events: auto;
  }
  .btn {
    padding: 15px 28px;
    border-radius: 999px;
    border: 1px solid var(--paper);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.25s, color 0.25s, transform 0.2s var(--ease);
  }
  .btn--solid,
  .btn:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .btn:active {
    transform: scale(0.98);
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @media (max-width: 760px) {
    .hd {
      grid-template-columns: auto 1fr;
      font-size: 11px;
      letter-spacing: 0.1em;
    }
    .hd > nav:first-child,
    .hd__hide {
      display: none;
    }
    .col:not(.col--main) {
      display: none;
    }
    .col video {
      filter: grayscale(1) contrast(1.08) brightness(0.85);
    }
    .word {
      font-size: 15.6vw;
      top: 44%;
    }
    .copy {
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: 84px;
    }
  }
</style>
