---
/** Новая главная «Подиум» выросла в магазин «Вариант 1» – старый адрес ведёт туда. */
const to = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/v1/`;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>ALEX KROWN – Вариант 1</title>
  </head>
  <body><a href={to}>Перейти на главную магазина</a></body>
</html>
