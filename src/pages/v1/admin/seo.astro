---
/** Админка → SEO-аналитика. Раздел «SEO-аналитика» кабинета EV SIBIR один в один: его же код (seo_map,
    page_seo) строит реестр и разметку – scripts/seo-ev.py → src/data/v1/analytics/seo-ev.json.
    Данные коммерческие: в публичной сборке раздел закрыт паролем (v1/admin/Vault.astro). */
import AdminV1 from '../../../layouts/AdminV1.astro';
import Vault from '../../../v1/admin/Vault.astro';
type Seo = { fetched_at: string; html: string };
const files = import.meta.glob<Seo>('../../../data/v1/analytics/seo-ev.json', { eager: true, import: 'default' });
const data = Object.values(files)[0];
---

<AdminV1 title="SEO-аналитика" active="seo">
  <Vault name="seo" open={!!data}>
    {data && <div class="seo-ev" set:html={data.html} />}
  </Vault>
</AdminV1>
