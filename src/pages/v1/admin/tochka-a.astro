---
/** Админка → Точка А. Раздел «Точка А» кабинета EV SIBIR один в один: его же код собирает слепок месяца
    и рисует экран (scripts/tochka-a-ev.py → src/data/v1/analytics/tochka-a-ev.json). Каждый месяц – свой
    вид, переключатель месяцев EV работает на месте. Данные коммерческие: в публичной сборке раздел закрыт
    паролем (v1/admin/Vault.astro). */
import AdminV1 from '../../../layouts/AdminV1.astro';
import Vault from '../../../v1/admin/Vault.astro';
type Ev = { months: string[]; views: Record<string, string> };
const files = import.meta.glob<Ev>('../../../data/v1/analytics/tochka-a-ev.json', { eager: true, import: 'default' });
const data = Object.values(files)[0];
const first = data?.months[0];
---

<AdminV1 title="Точка А" active="tochka">
  <Vault name="tochka-a" open={!!data}>
    {data && data.months.map((m) => <div class="ta-view" data-month={m} hidden={m !== first} set:html={data.views[m]} />)}
  </Vault>
</AdminV1>

<script>
  // Месяцы в EV – ссылки /admin/tochka-a?month=…; здесь все месяцы уже на странице, показываем нужный
  function show(month: string | null) {
    const views = document.querySelectorAll<HTMLElement>('.ta-view');
    if (!month || ![...views].some((v) => v.dataset.month === month)) return false;
    views.forEach((v) => (v.hidden = v.dataset.month !== month));
    return true;
  }
  const fromUrl = () => show(new URLSearchParams(location.search).get('month'));
  fromUrl();
  document.addEventListener('vault:open', fromUrl);
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest?.('a');
    const href = a?.getAttribute('href') || '';
    if (!href.startsWith('/admin/tochka-a')) return;
    e.preventDefault();
    const month = new URLSearchParams(href.split('?')[1] || '').get('month');
    if (show(month)) history.replaceState(null, '', '?month=' + month);
  });
</script>
