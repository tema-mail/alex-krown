---
/** Оформление заказа магазина «Вариант 1» – остров Order (данные корзины из localStorage). */
import V1 from '../../layouts/V1.astro';
import Order from '../../v1/islands/Order';
import { v1 } from '../../v1/site';
---

<V1 title="Оформление заказа | ALEX KROWN" description="Оформление заказа в магазине ALEX KROWN: доставка СДЭК по России и СНГ." path="order">
  <main class="page">
    <nav aria-label="Хлебные крошки"><ol class="crumbs"><li><a href={v1('')}>Главная</a></li><li><span aria-current="page">Оформление заказа</span></li></ol></nav>
    <header class="cat-head"><h1>Оформление заказа</h1></header>
    <Order client:load catalogHref={v1('catalog')} policyHref={v1('privatepolicy')} offerHref={v1('offer_agreement')} />
  </main>
</V1>
