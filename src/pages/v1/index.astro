---
/** Главная магазина «Вариант 1» – новая главная «Подиум» (src/pages/new/) на каркасе магазина:
    шапка, меню, подвал, корзина и избранное – layouts/V1.astro; видео, ленивые картинки,
    сердечки – v1/client.ts. Ссылки ведут на страницы магазина /v1/. */
import V1 from '../../layouts/V1.astro';
import ProductCard from '../../v1/ProductCard.astro';
import home from '../../data/home.json';
import { v1, section, byUid } from '../../v1/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => v1(p);
const img = (n: string) => `${base}/home/img/${n}.webp`;
/* атрибуты картинки: полная и вдвое меньшая версия (srcset), размеры против сдвига вёрстки */
const sz = home.sizes as Record<string, [number, number]>;
/* ниже первого экрана адрес картинки ставит скрипт за 600 px до появления (data-src): встроенная
   ленивая загрузка Chrome начинает качать за 1250–2500 px и отнимает канал у первого экрана */
const pic = (n: string, sizes: string, native = false) => {
  const [w, h] = sz[n];
  const src = img(n);
  const srcset = `${img(n + '-s')} ${Math.max(320, Math.round(w / 2))}w, ${img(n)} ${w}w`;
  const common = { sizes, width: w, height: h, loading: 'lazy' as const, decoding: 'async' as const };
  return native ? { src, srcset, ...common } : { 'data-src': src, 'data-srcset': srcset, ...common };
};
const vid = (n: string) => `${base}/concepts/video/${n}`;
const rub = (n: number) => n.toLocaleString('ru-RU').replace(/\u00a0/g, ' ') + ' ₽';
/* «Уже в продаже» – раздел «Горячие предложения» оригинала (тот же, что на /sale) */
const hot = (section('sale')?.uids ?? []).map((u) => byUid.get(u)!).filter(Boolean);
const cats = [
  ['Мужское', 'Коллекция мужской одежды, которая сочетает в себе открытость и смелость', '/catalog/man', 'cat-man'],
  ['Женское', 'Уникальная и смелая одежда для харизматичных женщин и девушек', '/catalog/woman', 'cat-woman'],
  ['Мужская обувь', 'Обувь, которая говорит о вашем характере', '/menshoes', 'cat-menshoes'],
  ['Женская обувь', 'Создайте свой уникальный образ с нашей обувью', '/womenshoes', 'cat-womenshoes'],
  ['Перепрошивка', 'Коллаборация Alex Krown и Hara People', '/firmware', 'cat-firmware'],
  ['Парфюм', 'Ароматы для ярких личностей, которые любят получать удовольствие от жизни', '/perfume', 'cat-perfume'],
];
const subs = [
  ['Мантии', '/catalog/man/robes', 'sub-robes'],
  ['Футболки', '/catalog/man/t-shirts', 'sub-tshirts'],
  ['Топы', '/catalog/woman/tops', 'sub-tops'],
  ['Свитшоты', '/catalog/woman/sweatshirts', 'sub-sweatshirts'],
];
/* капсулы «Total look»: ссылки – как на живой главной (у «Куртки-жакета» там ссылка на джоггеры) */
const caps = [
  [['Топ «No Rules»', 3400, '/catalog/woman/tproduct/827495152472-top-no-rules'], ['Шорты «No Rules»', 4300, '/catalog/woman/tproduct/761894198242-shorti-no-rules']],
  [['Утепленный пуловер', 6900, '/catalog/man/tproduct/320757651222-uteplennii-pulover'], ['Брюки White man', 8200, '/catalog/man/tproduct/550765990892-dzhoggeri-white-man-uteplennie']],
  [['Лосины', 8900, '/catalog/woman/tproduct/634469130762-losini'], ['Куртка-жакет', 15500, '/catalog/man/tproduct/550765990892-dzhoggeri-white-man-uteplennie']],
  [['Майка «Geometry black»', 5500, '/catalog/man/tproduct/841640507702-maika-geometry-black'], ['Шорты «Geometry black»', 6500, '/catalog/man/tproduct/424007587352-shorti-geometry-black']],
] as const;
/* «Новая коллекция»: костюм Cardiogram Black – цены и размеры с сайта (по 6 900 ₽, S–XXL),
   видео – клипы VK бренда (scripts/collection-media.mjs). У худи на сайте нет фото – кадр из клипа. */
const hv = (n: string) => `${base}/home/video/${n}`;
const collection = [
  { title: 'Худи “Cardiogram Black”', price: 6900, url: '/catalog/man/tproduct/238837028463-hudi-cardiogram-black', photo: 'cardiogram-hoodie-photo', video: 'cardiogram-hoodie.mp4' },
  { title: 'Джоггеры “Cardiogram Black”', price: 6900, url: '/catalog/man/tproduct/766491981613-dzhoggeri-cardiogram-black', photo: 'cardiogram-joggers-photo', video: 'cardiogram-joggers.mp4' },
];
const reel = [
  ['campaign-white-suit', 'Девушка в белом худи ALEX KROWN с капюшоном'],
  ['milan-mfw2025-street', 'Модель ALEX KROWN у площадки Milan Fashion Week 2025'],
  ['campaign-black-street', 'Мужчина в чёрном худи и джоггерах ALEX KROWN идёт по улице'],
];
---

<V1
  title="Дизайнерская одежда ALEX KROWN – мужская и женская | Доставка по России"
  description="Дизайнерская одежда ALEX KROWN для мужчин и женщин: худи, куртки, брюки, платья и аксессуары. Собственное производство, доставка по России и СНГ."
  path=""
  hero
  image={`${base}/concepts/video/milan-mfw2025-street.webp`}
>
    <main>
      <section class="hero" data-hero>
        <div class="reel">
          {
            reel.map(([n, alt], i) => (
              <figure class={`col${i === 1 ? ' col--main' : ''}`} style={`--i:${i}`}>
                <img class="col__poster" src={vid(`${n}.webp`)} srcset={`${vid(`${n}-s.webp`)} 360w, ${vid(`${n}-m.webp`)} 540w, ${vid(`${n}.webp`)} 720w`} sizes="(max-width: 760px) 100vw, 36vw" width="720" height="1280" alt={alt} loading={i === 1 ? 'eager' : 'lazy'} decoding="async" />
                <video data-src={vid(`${n}.mp4`)} muted loop playsinline preload="none" aria-hidden="true" />
                {i === 1 && <figcaption>Milan Fashion Week 2025</figcaption>}
              </figure>
            ))
          }
        </div>
        <p class="hero__word" aria-hidden="true">ALEX KROWN</p>
        <div class="hero__copy">
          <h1>Дизайнерская одежда ALEX KROWN для мужчин и женщин</h1>
          <div class="hero__cta">
            <a class="btn btn--solid" href={link('/catalog/man')}>Мужское</a>
            <a class="btn" href={link('/catalog/woman')}>Женское</a>
          </div>
        </div>
      </section>

      <section class="wrap nc" aria-labelledby="nc-title">
        <div class="nc__media">
          <figure class="nc__film">
            <img data-src={hv('cardiogram-street.webp')} width="720" height="1280" alt="Мужчина в костюме Cardiogram Black идёт по улице" decoding="async" />
            <video data-film={hv('cardiogram-street.mp4')} muted loop playsinline preload="none" aria-hidden="true"></video>
          </figure>
          <figure class="nc__film nc__film--2">
            <img data-src={hv('cardiogram-mirror.webp')} width="480" height="854" alt="Костюм Cardiogram Black, съёмка в зеркало" decoding="async" />
            <video data-film={hv('cardiogram-mirror.mp4')} muted loop playsinline preload="none" aria-hidden="true"></video>
          </figure>
        </div>
        <div class="nc__info" data-reveal>
          <p class="label">Новая коллекция</p>
          <h2 class="h2" id="nc-title">Cardiogram Black</h2>
          <p class="nc__text">Костюм из худи и джоггеров с белой строчкой-кардиограммой. Размеры S–XXL.</p>
          <div class="nc__cards">
            {
              collection.map((p) => (
                <a class="prod" href={link(p.url)}>
                  <div class="prod__img" data-hover-video={hv(p.video)}>
                    <img class="bw" {...pic(p.photo, '(max-width: 760px) 46vw, 20vw')} alt={p.title} />
                  </div>
                  <p class="prod__name">{p.title}</p>
                  <p class="prod__price">{rub(p.price)}</p>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="wrap" id="categories">
        <div class="cats__head" data-reveal>
          <span class="label">ALEX KROWN</span>
          <h2 class="h2">Выберите категорию</h2>
        </div>
        <div class="cats">
          {
            cats.map(([t, d, h, im]) => (
              <a class="cat" href={link(h)} data-reveal>
                <h3>{t}</h3>
                <p>{d}</p>
                <span class="btn">Смотреть</span>
                <img class="bw" {...pic(im, '(max-width: 760px) 46vw, 28vw')} alt="" />
              </a>
            ))
          }
        </div>
      </section>

      <section class="wrap">
        <div class="shop__head" data-reveal>
          <h2 class="h2">Уже в продаже</h2>
          <a href={link('/catalog')}>Весь каталог</a>
        </div>
        <div class="grid">{hot.map((p) => <ProductCard p={p} bw />)}</div>
      </section>

      <section class="wrap brand">
        <p class="label" data-reveal>Одежда для тех, кто создаёт свои правила</p>
        <p class="brand__word" aria-hidden="true">ALEX KROWN</p>
        <a class="promo" href={link('/sale')} data-reveal>
          <div class="promo__text" style="text-align:left">
            <p class="label">Онлайн на весь ассортимент</p>
            <p class="promo__big">−20% на все</p>
            <span class="btn btn--solid">В каталог</span>
          </div>
          <img class="bw" {...pic('promo-couple', '(max-width: 900px) 92vw, 48vw')} alt="Пара в куртках ALEX KROWN" />
        </a>
        <div class="subs">
          {
            subs.map(([t, h, im]) => (
              <a class="sub" href={link(h)} data-reveal>
                <div class="sub__img">
                  <img class="bw" {...pic(im, '(max-width: 900px) 46vw, 23vw')} alt="" />
                </div>
                <span>{t}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="wrap">
        <p class="about__text" data-reveal>
          Благодаря умению придавать свежий образ привычным элементам одежды, преданности своим идеям и непрерывному
          развитию бренд является одним из лидеров отечественного рынка уличной моды.
        </p>
        <div class="perks" data-reveal>
          <p class="perk"><span class="perk__mark">✓</span>Уникальный дизайн</p>
          <p class="perk"><span class="perk__mark">✓</span>Собственное производство</p>
          <p class="perk"><span class="perk__mark">✓</span>Доставка по всей России и странам СНГ</p>
        </div>
      </section>

      <section class="wrap caps" data-caps>
        {
          caps.map((items, i) => (
            <div class={`cap${i === 0 ? ' is-active' : ''}`} data-cap>
              <div class="cap__main">
                <img class="bw" {...pic(`cap-${i + 1}`, '(max-width: 760px) 92vw, 48vw')} alt="Готовый образ ALEX KROWN" />
              </div>
              <div class="cap__side">
                <p class="label">Готовая капсула</p>
                <h2 class="h2" style="margin-top:12px">Total look</h2>
                <div class="cap__nav">
                  <button type="button" data-cap-prev aria-label="Предыдущая капсула">←</button>
                  <button type="button" data-cap-next aria-label="Следующая капсула">→</button>
                  <span class="cap__count" aria-live="polite">{i + 1} / {caps.length}</span>
                </div>
                <div class="cap__items">
                  {items.map(([t, price, h], k) => (
                    <a class="prod" href={link(h)}>
                      <div class="prod__img">
                        <img class="bw" {...pic(`cap-${i + 1}${k ? 'b' : 'a'}`, '(max-width: 760px) 46vw, 23vw')} alt={t} />
                      </div>
                      <p class="prod__name">{t}</p>
                      <p class="prod__price">{rub(price)}</p>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </section>

      <section class="wrap">
        <div class="bonus">
          <div class="bonus__card" data-reveal>
            <div class="bonus__img">
              <div class="loyal">
                <img class="bw" {...pic('bonus-loyal-card', '(max-width: 760px) 50vw, 18vw')} alt="Карта лояльности ALEX KROWN" />
                <p class="loyal__scale"><span>10%</span><span>20%</span><span>30%</span></p>
              </div>
            </div>
            <span>Программа лояльности</span>
          </div>
          <a class="bonus__card" href={link('/sale')} data-reveal>
            <div class="bonus__img"><img class="bw" {...pic('bonus-sets', '(max-width: 760px) 80vw, 28vw')} alt="Наборы ALEX KROWN" /></div>
            <span>Наборы со скидкой</span>
          </a>
          <a class="bonus__card" href={link('/catalog/tproduct/958987974882-podarochnii-sertifikat')} data-reveal>
            <div class="bonus__img"><img class="bw" {...pic('bonus-gift-cards', '(max-width: 760px) 80vw, 28vw')} alt="Подарочные сертификаты ALEX KROWN" /></div>
            <span>Подарочные сертификаты</span>
          </a>
        </div>
      </section>

      <section class="gallery" aria-label="Кампания ALEX KROWN">
        <div class="gallery__track" data-gallery>
          {
            Array.from({ length: home.gallery }, (_, i) => (
              <figure>
                <img {...pic(`gal-${i + 1}`, '(max-width: 760px) 86vw, 78vw', true)} alt="Кадр кампании ALEX KROWN" />
              </figure>
            ))
          }
        </div>
        <div class="gallery__nav wrap">
          <button type="button" data-gal="-1" aria-label="Назад">←</button>
          <button type="button" data-gal="1" aria-label="Вперёд">→</button>
        </div>
      </section>
    </main>
</V1>

<script>
  /* капсулы Total look */
  const caps = [...document.querySelectorAll<HTMLElement>('[data-cap]')];
  let cap = 0;
  const showCap = (d: number) => {
    caps[cap].classList.remove('is-active');
    cap = (cap + d + caps.length) % caps.length;
    caps[cap].classList.add('is-active');
  };
  document.querySelectorAll('[data-cap-prev]').forEach((b) => b.addEventListener('click', () => showCap(-1)));
  document.querySelectorAll('[data-cap-next]').forEach((b) => b.addEventListener('click', () => showCap(1)));

  /* галерея кампании */
  const track = document.querySelector<HTMLElement>('[data-gallery]')!;
  document.querySelectorAll<HTMLElement>('[data-gal]').forEach((b) =>
    b.addEventListener('click', () => {
      const step = (track.querySelector('figure') as HTMLElement).offsetWidth + 8;
      track.scrollBy({ left: Number(b.dataset.gal) * step, behavior: 'smooth' });
    }),
  );
</script>
